COMPOSE_PROJECT_NAME=asternic-lite
dbhost=database
dbname=qstatslite
dbuser=qstatslite
dbpass=changeme!

# Credentials for AMI (for the realtime tab to work)
# See /etc/asterisk/manager.conf
manager_host=127.0.0.1
manager_user=qstats
manager_pass=changeme

# Time zone for queue_stats.datetime written by parselog (default UTC, which
# is what the old PHP parselog container used). Changing it on an existing
# database shifts new events against the old ones.
#TZ=Europe/Warsaw
